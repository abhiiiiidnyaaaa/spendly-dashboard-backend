<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Subscription Reminder</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f6f9; padding: 40px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08);">
          <!-- Header -->
          <tr>
            <td style="background: linear-gradient(135deg, #3b82f6, #06b6d4); padding: 40px 40px 30px; text-align: center;">
              <h1 style="color: #ffffff; margin: 0; font-size: 28px; font-weight: 700;">
                🔔 Subscription Reminder
              </h1>
              <p style="color: rgba(255,255,255,0.85); margin: 10px 0 0; font-size: 16px;">
                A subscription is renewing soon
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 40px;">
              <p style="color: #1e293b; font-size: 18px; margin: 0 0 8px; font-weight: 600;">
                Hi {{name}},
              </p>
              <p style="color: #64748b; font-size: 15px; line-height: 1.7; margin: 0 0 24px;">
                Just a heads up — your subscription <strong>{{subscriptionName}}</strong> is set to renew on <strong>{{renewalDate}}</strong>.
              </p>

              <!-- Subscription Card -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                <tr>
                  <td style="background-color: #f0f9ff; border-radius: 12px; padding: 24px; border: 1px solid #bae6fd;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td>
                          <p style="color: #1e293b; font-size: 18px; font-weight: 700; margin: 0 0 4px;">
                            {{subscriptionName}}
                          </p>
                          <p style="color: #64748b; font-size: 13px; margin: 0;">
                            {{category}} • {{billingCycle}}
                          </p>
                        </td>
                        <td style="text-align: right;">
                          <p style="color: #3b82f6; font-size: 24px; font-weight: 700; margin: 0;">
                            {{currency}} {{amount}}
                          </p>
                          <p style="color: #94a3b8; font-size: 12px; margin: 4px 0 0;">
                            per {{billingCycle}}
                          </p>
                        </td>
                      </tr>
                    </table>

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 16px; border-top: 1px solid #bae6fd; padding-top: 16px;">
                      <tr>
                        <td width="50%">
                          <p style="color: #94a3b8; font-size: 11px; margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.5px;">Renewal Date</p>
                          <p style="color: #1e293b; font-size: 14px; font-weight: 600; margin: 0;">{{renewalDate}}</p>
                        </td>
                        <td width="50%" style="text-align: right;">
                          <p style="color: #94a3b8; font-size: 11px; margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.5px;">Days Until Renewal</p>
                          <p style="color: #f59e0b; font-size: 14px; font-weight: 600; margin: 0;">{{daysUntilRenewal}} days</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 8px 0 24px;">
                    <a href="{{dashboardUrl}}" style="display: inline-block; background: linear-gradient(135deg, #3b82f6, #06b6d4); color: #ffffff; text-decoration: none; padding: 14px 36px; border-radius: 8px; font-size: 15px; font-weight: 600;">
                      Manage Subscriptions →
                    </a>
                  </td>
                </tr>
              </table>

              <p style="color: #94a3b8; font-size: 13px; line-height: 1.6; margin: 0; text-align: center;">
                Review and manage all your active subscriptions from the dashboard.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f8fafc; padding: 24px 40px; text-align: center; border-top: 1px solid #e2e8f0;">
              <p style="color: #94a3b8; font-size: 12px; margin: 0;">
                © {{year}} SaaS Dashboard. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
