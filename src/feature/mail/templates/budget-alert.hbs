<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Budget Alert</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f6f9; padding: 40px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08);">
          <!-- Header -->
          <tr>
            <td style="background: linear-gradient(135deg, #f59e0b, #ef4444); padding: 40px 40px 30px; text-align: center;">
              <h1 style="color: #ffffff; margin: 0; font-size: 28px; font-weight: 700;">
                ⚠️ Budget Alert
              </h1>
              <p style="color: rgba(255,255,255,0.85); margin: 10px 0 0; font-size: 16px;">
                You're approaching your spending limit
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 40px;">
              <p style="color: #1e293b; font-size: 18px; margin: 0 0 8px; font-weight: 600;">
                Hi {{name}},
              </p>
              <p style="color: #64748b; font-size: 15px; line-height: 1.7; margin: 0 0 24px;">
                Your spending in <strong>{{category}}</strong> has reached <strong>{{percentUsed}}%</strong> of your monthly budget for <strong>{{monthYear}}</strong>.
              </p>

              <!-- Budget Progress Card -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                <tr>
                  <td style="background-color: #f8fafc; border-radius: 12px; padding: 24px; border: 1px solid #e2e8f0;">
                    <!-- Category Title -->
                    <p style="color: #1e293b; font-size: 16px; font-weight: 700; margin: 0 0 16px;">
                      {{category}}
                    </p>

                    <!-- Progress Bar -->
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 16px;">
                      <tr>
                        <td style="background-color: #e2e8f0; border-radius: 8px; height: 12px; overflow: hidden;">
                          <table role="presentation" width="{{percentUsed}}%" cellpadding="0" cellspacing="0">
                            <tr>
                              <td style="background: linear-gradient(90deg, #f59e0b, #ef4444); border-radius: 8px; height: 12px;"></td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                    <!-- Stats Row -->
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td width="33%" style="text-align: center; padding: 8px;">
                          <p style="color: #94a3b8; font-size: 11px; margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.5px;">Spent</p>
                          <p style="color: #ef4444; font-size: 18px; font-weight: 700; margin: 0;">{{currency}} {{spentAmount}}</p>
                        </td>
                        <td width="33%" style="text-align: center; padding: 8px; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;">
                          <p style="color: #94a3b8; font-size: 11px; margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.5px;">Limit</p>
                          <p style="color: #1e293b; font-size: 18px; font-weight: 700; margin: 0;">{{currency}} {{limitAmount}}</p>
                        </td>
                        <td width="33%" style="text-align: center; padding: 8px;">
                          <p style="color: #94a3b8; font-size: 11px; margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.5px;">Remaining</p>
                          <p style="color: #22c55e; font-size: 18px; font-weight: 700; margin: 0;">{{currency}} {{remainingAmount}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="padding: 8px 0 24px;">
                    <a href="{{dashboardUrl}}" style="display: inline-block; background: linear-gradient(135deg, #f59e0b, #ef4444); color: #ffffff; text-decoration: none; padding: 14px 36px; border-radius: 8px; font-size: 15px; font-weight: 600;">
                      View Budget Details →
                    </a>
                  </td>
                </tr>
              </table>

              <p style="color: #94a3b8; font-size: 13px; line-height: 1.6; margin: 0; text-align: center;">
                You can adjust your budget limits anytime from the dashboard.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f8fafc; padding: 24px 40px; text-align: center; border-top: 1px solid #e2e8f0;">
              <p style="color: #94a3b8; font-size: 12px; margin: 0;">
                © {{year}} SaaS Dashboard. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
